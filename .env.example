# Copie para .env.local e preencha. Nunca versione valores reais.

# --- Aplicação ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# Chave anônima (anon) ou publishable do projeto
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Ignora RLS: nunca expor ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Criptografia de tokens (32 bytes em base64: `openssl rand -base64 32`) ---
ENCRYPTION_KEY=

# --- Meta WhatsApp Cloud API ---
META_GRAPH_VERSION=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# --- Agendador (segredo enviado pelo cron em Authorization: Bearer) ---
CRON_SECRET=

# --- Upstash Redis (rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
